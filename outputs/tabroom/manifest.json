{
  "manifest_version": 3,
  "name": "탭룸 · Tabroom",
  "description": "열린 탭의 실시간 미리보기와 채팅용 탭 참조 선택",
  "version": "0.6.24",
  "minimum_chrome_version": "142",
  "permissions": [
    "tabs",
    "debugger",
    "sidePanel",
    "storage",
    "system.cpu",
    "nativeMessaging",
    "topSites",
    "favicon",
    "tabGroups",
    "downloads"
  ],
  "optional_permissions": ["history"],
  "options_page": "history-options.html",
  "web_accessible_resources": [{
    "resources": ["history-options.html"],
    "matches": ["http://127.0.0.1/*"]
  }],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "capture-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "탭룸 사이드 패널"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*"
    ]
  }
}
